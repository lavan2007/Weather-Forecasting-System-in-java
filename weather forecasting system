import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import javax.swing.table.DefaultTableCellRenderer;
import java.awt.*;
import java.io.*;
import java.net.*;
import java.sql.*;
import org.json.JSONObject;

public class WeatherApp1 {

    private static final String API_KEY = "YOUR_API_KEY";
    private static final String DB_URL = "jdbc:sqlite:weather_history.db";

    private JFrame frame;

    public static void main(String[] args) {
        setupDatabase();
        SwingUtilities.invokeLater(() -> new WeatherApp1().createAndShowGUI());
    }

    private void createAndShowGUI() {
        frame = new JFrame("Weather Forecast");
        frame.setSize(650, 520);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLocationRelativeTo(null);
        frame.getContentPane().setBackground(new Color(200, 230, 255));
        frame.setLayout(new GridBagLayout());

        GridBagConstraints c = new GridBagConstraints();
        c.insets = new Insets(8, 8, 8, 8);
        c.fill = GridBagConstraints.HORIZONTAL;
        c.gridx = 0;
        c.gridwidth = 2;

        JLabel title = new JLabel("Weather Forecast", SwingConstants.CENTER);
        title.setFont(new Font("Arial", Font.BOLD, 24));
        c.gridy = 0;
        frame.add(title, c);

        JLabel cityLabel = new JLabel("Enter City:");
        cityLabel.setFont(new Font("Arial", Font.PLAIN, 16));
        c.gridy = 1;
        frame.add(cityLabel, c);

        JTextField cityField = new JTextField(20);
        cityField.setFont(new Font("Arial", Font.PLAIN, 16));
        c.gridy = 2;
        frame.add(cityField, c);

        JLabel timeLabel = new JLabel("Enter Time (e.g. 10:30 AM):");
        timeLabel.setFont(new Font("Arial", Font.PLAIN, 16));
        c.gridy = 3;
        frame.add(timeLabel, c);

        JTextField timeField = new JTextField(20);
        timeField.setFont(new Font("Arial", Font.PLAIN, 16));
        c.gridy = 4;
        frame.add(timeField, c);

        JPanel buttonPanel = new JPanel();
        buttonPanel.setBackground(new Color(200, 230, 255));

        JButton getButton = new JButton("Get Weather");
        JButton clearButton = new JButton("Clear");
        JButton viewHistoryButton = new JButton("View History");

        buttonPanel.add(getButton);
        buttonPanel.add(clearButton);
        buttonPanel.add(viewHistoryButton);

        c.gridy = 5;
        frame.add(buttonPanel, c);

        JTextArea resultArea = new JTextArea(6, 40);
        resultArea.setFont(new Font("Arial", Font.PLAIN, 16));
        resultArea.setLineWrap(true);
        resultArea.setWrapStyleWord(true);
        resultArea.setEditable(false);

        JScrollPane scrollPane = new JScrollPane(resultArea);
        c.gridy = 6;
        frame.add(scrollPane, c);

        frame.setVisible(true);

        getButton.addActionListener(e -> {
            String city = cityField.getText().trim();
            String time = timeField.getText().trim();

            if (city.isEmpty()) {
                JOptionPane.showMessageDialog(
                    frame,
                    "Please enter a city name.",
                    "Error",
                    JOptionPane.ERROR_MESSAGE
                );
                return;
            }

            fetchAndDisplayWeather(
                city,
                time.isEmpty() ? "—" : time,
                resultArea
            );
        });

        clearButton.addActionListener(e -> {
            cityField.setText("");
            timeField.setText("");
            resultArea.setText("");
        });

        viewHistoryButton.addActionListener(e -> {
            HistoryDialog hd = new HistoryDialog(frame);
            hd.setVisible(true);
        });
    }

    private void fetchAndDisplayWeather(
            String city, String time, JTextArea outArea) {

        try {
            String urlString =
                "https://api.openweathermap.org/data/2.5/weather?q="
                + URLEncoder.encode(city, "UTF-8")
                + "&appid=" + API_KEY + "&units=metric";

            URL url = new URL(urlString);
            HttpURLConnection conn =
                (HttpURLConnection) url.openConnection();

            conn.setRequestMethod("GET");
            conn.setConnectTimeout(8000);
            conn.setReadTimeout(8000);

            int status = conn.getResponseCode();

            InputStream is = (status >= 200 && status < 300)
                ? conn.getInputStream()
                : conn.getErrorStream();

            BufferedReader in = new BufferedReader(
                new InputStreamReader(is)
            );

            StringBuilder response = new StringBuilder();
            String line;

            while ((line = in.readLine()) != null) {
                response.append(line);
            }

            in.close();
            conn.disconnect();

            if (status < 200 || status >= 300) {
                JOptionPane.showMessageDialog(
                    frame,
                    "API error or city not found.",
                    "Error",
                    JOptionPane.ERROR_MESSAGE
                );
                return;
            }

            JSONObject data = new JSONObject(response.toString());
            JSONObject main = data.getJSONObject("main");
            JSONObject wind = data.getJSONObject("wind");

            String weather = data.getJSONArray("weather")
                .getJSONObject(0)
                .getString("description");

            double temp = main.getDouble("temp");
            int humidity = main.getInt("humidity");

            double windSpeed = wind.has("speed")
                ? wind.getDouble("speed")
                : 0.0;

            String condition = capitalize(weather);

            String output = String.format(
                "City: %s\nTime: %s\nTemperature: %.1f°C\n"
                + "Condition: %s\nHumidity: %d%%\n"
                + "Wind Speed: %.1f m/s",
                city, time, temp, condition, humidity, windSpeed
            );

            outArea.setText(output);

            saveWeatherToDB(
                city, time, temp, condition, humidity, windSpeed
            );

        } catch (FileNotFoundException ex) {
            JOptionPane.showMessageDialog(
                frame,
                "City not found or API endpoint returned no data.",
                "Error",
                JOptionPane.ERROR_MESSAGE
            );
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(
                frame,
                "Failed to get weather data.\n" + ex.getMessage(),
                "Error",
                JOptionPane.ERROR_MESSAGE
            );
        }
    }

    private static void setupDatabase() {
        String createSQL =
            "CREATE TABLE IF NOT EXISTS weather_history ("
            + "id INTEGER PRIMARY KEY AUTOINCREMENT,"
            + "city TEXT,"
            + "time TEXT,"
            + "temperature REAL,"
            + "condition TEXT,"
            + "humidity INTEGER,"
            + "wind REAL,"
            + "created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
            + ")";

        try (Connection conn = DriverManager.getConnection(DB_URL);
             Statement st = conn.createStatement()) {

            st.execute(createSQL);

        } catch (SQLException e) {
            JOptionPane.showMessageDialog(
                null,
                "DB setup error: " + e.getMessage(),
                "DB Error",
                JOptionPane.ERROR_MESSAGE
            );
        }
    }

    private static void saveWeatherToDB(
            String city, String time, double temp,
            String condition, int humidity, double wind) {

        String insertSQL =
            "INSERT INTO weather_history"
            + "(city, time, temperature, condition, humidity, wind)"
            + " VALUES (?, ?, ?, ?, ?, ?)";

        try (Connection conn = DriverManager.getConnection(DB_URL);
             PreparedStatement ps = conn.prepareStatement(insertSQL)) {

            ps.setString(1, city);
            ps.setString(2, time);
            ps.setDouble(3, temp);
            ps.setString(4, condition);
            ps.setInt(5, humidity);
            ps.setDouble(6, wind);

            ps.executeUpdate();

        } catch (SQLException e) {
            JOptionPane.showMessageDialog(
                null,
                "Failed to save history: " + e.getMessage(),
                "DB Error",
                JOptionPane.ERROR_MESSAGE
            );
        }
    }

    private static void deleteAllHistoryDB() {
        String deleteSQL = "DELETE FROM weather_history";

        try (Connection conn = DriverManager.getConnection(DB_URL);
             Statement st = conn.createStatement()) {

            st.executeUpdate(deleteSQL);

        } catch (SQLException e) {
            JOptionPane.showMessageDialog(
                null,
                "Failed to delete history: " + e.getMessage(),
                "DB Error",
                JOptionPane.ERROR_MESSAGE
            );
        }
    }

    private static void deleteHistoryRowById(int id) {
        String deleteSQL =
            "DELETE FROM weather_history WHERE id = ?";

        try (Connection conn = DriverManager.getConnection(DB_URL);
             PreparedStatement ps = conn.prepareStatement(deleteSQL)) {

            ps.setInt(1, id);
            ps.executeUpdate();

        } catch (SQLException e) {
            JOptionPane.showMessageDialog(
                null,
                "Failed to delete record: " + e.getMessage(),
                "DB Error",
                JOptionPane.ERROR_MESSAGE
            );
        }
    }

    private class HistoryDialog extends JDialog {

        private final DefaultTableModel model;
        private final JTable table;

        HistoryDialog(Frame owner) {
            super(owner, "Weather Search History", true);

            setSize(760, 380);
            setLocationRelativeTo(owner);
            setLayout(new BorderLayout(8, 8));

            String[] cols = {
                "ID", "City", "Time", "Temp (°C)",
                "Condition", "Humidity (%)",
                "Wind (m/s)", "Created At"
            };

            model = new DefaultTableModel(cols, 0) {
                @Override
                public boolean isCellEditable(int r, int c) {
                    return false;
                }
            };

            table = new JTable(model);
            table.setFillsViewportHeight(true);
            table.setRowHeight(22);

            DefaultTableCellRenderer center =
                new DefaultTableCellRenderer();

            center.setHorizontalAlignment(SwingConstants.CENTER);

            table.getColumnModel().getColumn(0)
                .setCellRenderer(center);
            table.getColumnModel().getColumn(3)
                .setCellRenderer(center);
            table.getColumnModel().getColumn(5)
                .setCellRenderer(center);
            table.getColumnModel().getColumn(6)
                .setCellRenderer(center);

            JScrollPane sp = new JScrollPane(table);
            add(sp, BorderLayout.CENTER);

            JPanel control =
                new JPanel(new FlowLayout(FlowLayout.RIGHT));

            JButton refreshBtn = new JButton("Refresh");
            JButton deleteSelectedBtn =
                new JButton("Delete Selected");
            JButton deleteAllBtn = new JButton("Delete All");
            JButton closeBtn = new JButton("Close");

            control.add(refreshBtn);
            control.add(deleteSelectedBtn);
            control.add(deleteAllBtn);
            control.add(closeBtn);

            add(control, BorderLayout.SOUTH);

            refreshBtn.addActionListener(
                e -> loadHistoryIntoModel()
            );

            deleteSelectedBtn.addActionListener(e -> {
                int sel = table.getSelectedRow();

                if (sel == -1) {
                    JOptionPane.showMessageDialog(
                        this,
                        "Select a row to delete.",
                        "Info",
                        JOptionPane.INFORMATION_MESSAGE
                    );
                    return;
                }

                int modelRow = table.convertRowIndexToModel(sel);
                Object idObj = model.getValueAt(modelRow, 0);

                if (idObj != null) {
                    int id = Integer.parseInt(idObj.toString());

                    int confirm = JOptionPane.showConfirmDialog(
                        this,
                        "Delete selected record (ID: " + id + ")?",
                        "Confirm",
                        JOptionPane.YES_NO_OPTION
                    );

                    if (confirm == JOptionPane.YES_OPTION) {
                        deleteHistoryRowById(id);
                        loadHistoryIntoModel();
                    }
                }
            });

            deleteAllBtn.addActionListener(e -> {
                int confirm = JOptionPane.showConfirmDialog(
                    this,
                    "Delete ALL history? This cannot be undone.",
                    "Confirm Delete All",
                    JOptionPane.YES_NO_OPTION
                );

                if (confirm == JOptionPane.YES_OPTION) {
                    deleteAllHistoryDB();
                    loadHistoryIntoModel();
                }
            });

            closeBtn.addActionListener(e -> dispose());

            loadHistoryIntoModel();
        }

        private void loadHistoryIntoModel() {
            model.setRowCount(0);

            String selectSQL =
                "SELECT id, city, time, temperature, condition, "
                + "humidity, wind, created_at FROM weather_history "
                + "ORDER BY id DESC";

            try (Connection conn = DriverManager.getConnection(DB_URL);
                 Statement st = conn.createStatement();
                 ResultSet rs = st.executeQuery(selectSQL)) {

                while (rs.next()) {
                    Object[] row = {
                        rs.getInt("id"),
                        rs.getString("city"),
                        rs.getString("time"),
                        rs.getDouble("temperature"),
                        rs.getString("condition"),
                        rs.getInt("humidity"),
                        rs.getDouble("wind"),
                        rs.getString("created_at")
                    };

                    model.addRow(row);
                }

            } catch (SQLException e) {
                JOptionPane.showMessageDialog(
                    this,
                    "Failed to load history: " + e.getMessage(),
                    "DB Error",
                    JOptionPane.ERROR_MESSAGE
                );
            }
        }
    }

    private static String capitalize(String s) {
        if (s == null || s.isEmpty()) {
            return s;
        }

        return s.substring(0, 1).toUpperCase() + s.substring(1);
    }
}
